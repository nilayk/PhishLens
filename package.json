{
  "name": "phishlens",
  "version": "0.3.0",
  "private": true,
  "description": "Explainable phishing, malware and social-engineering risk analysis for Gmail, as a Chrome MV3 extension.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "dev": "node scripts/build.mjs --dev --watch",
    "harness": "node scripts/harness.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "clean": "node scripts/build.mjs --clean-only",
    "check:dist": "node scripts/check-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.0"
  }
}
